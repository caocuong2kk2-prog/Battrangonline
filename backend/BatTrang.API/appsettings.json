{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BatTrangDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_HERE",
    "Issuer": "YOUR_JWT_ISSUER_HERE",
    "Audience": "YOUR_JWT_AUDIENCE_HERE"
  },
  "EmailSetting": {
    "Enabled": true,
    "Host": "YOUR_SMTP_HOST_HERE",
    "Port": 587,
    "Username": "YOUR_EMAIL_USERNAME_HERE",
    "Password": "YOUR_EMAIL_APP_PASSWORD_HERE",
    "FromEmail": "YOUR_FROM_EMAIL_HERE",
    "FromName": "YOUR_FROM_NAME_HERE"
  },
  "ReCaptcha": {
    "SiteKey": "YOUR_RECAPTCHA_SITE_KEY_HERE",
    "SecretKey": "YOUR_RECAPTCHA_SECRET_KEY_HERE"
  },
  "BackupSettings": {
    "BackupFolder": "h:\\WORK\\Battrangonline\\backend\\Backups",
    "RunAtHour": 2,
    "KeepDays": 7
  }
}